{
  "manifest_version": 3,
  "name": "Ethify Download Catcher",
  "version": "0.1.1",
  "description": "Route supported browser downloads through Ethify's selected network adapters.",
  "key": "",
  "permissions": ["downloads", "storage", "cookies", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:18889/*", "<all_urls>"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ethify Download Catcher"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
