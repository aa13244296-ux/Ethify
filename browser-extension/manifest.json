{
  "manifest_version": 3,
  "name": "Ethify Download Catcher",
  "version": "0.1.1",
  "description": "Route supported browser downloads through Ethify's selected network adapters.",
  "permissions": ["downloads", "storage"],
  "host_permissions": ["http://127.0.0.1:18889/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ethify Download Catcher"
  }
}
